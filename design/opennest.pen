                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Seat",
                      "lineHeight": 1.2,
                      "fontFamily": "$font-sans",
                      "fontSize": 21,
                      "fontWeight": "500",
                      "letterSpacing": -0.5
                    },
                    {
                      "type": "text",
                      "id": "y0Hy3",
                      "name": "Body",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "The walls meet the seat in a square corner. Nothing lifts the edge of the plate, so its height stays the height you taught.",
                      "lineHeight": 1.52,
                      "fontFamily": "$font-sans",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
