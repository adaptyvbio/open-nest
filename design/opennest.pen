                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Plastic plates grow faster than aluminium. By calculation, at 37 °C a plate at the ±0.5 mm limit is 0.06 mm too big in X and 0.05 mm in Y, and one within ±0.25 mm still clears by about 0.2 mm. Float of ±0.27 mm is comfortable for 96 and 384 wells. Check your tolerances before you run 1536-well plates.",
                  "lineHeight": 1.46,
                  "fontFamily": "$font-sans",
                  "fontSize": 12.5,
                  "fontWeight": "normal"
                }
